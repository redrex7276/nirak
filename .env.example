# ==============================================================================
# SHRAMIK-QUOTE — Environment Variables Configuration Template
# ==============================================================================
# Duplicate this file to `.env` or `.env.local` for local development.
# Do NOT commit sensitive keys or credentials to version control.
# ==============================================================================

# Application Environment
VITE_APP_NAME=Shramik-Quote
VITE_APP_ENV=development
VITE_APP_PORT=5173

# SMS Gateway Configuration (Optional - Defaults to internal MockSMSProvider)
# Supported Providers: mock | twilio | msg91 | fast2sms | aws_sns
VITE_SMS_PROVIDER=mock

# Twilio SMS Credentials (When VITE_SMS_PROVIDER=twilio)
# VITE_TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VITE_TWILIO_AUTH_TOKEN=your_auth_token_here
# VITE_TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# MSG91 / Fast2SMS Credentials (When VITE_SMS_PROVIDER=msg91 or fast2sms)
# VITE_MSG91_AUTH_KEY=your_msg91_auth_key
# VITE_FAST2SMS_API_KEY=your_fast2sms_api_key

# Default Regional Language (en | hi | mr)
VITE_DEFAULT_LANGUAGE=en

# Demo / Presentation Mode (true enables deterministic seed data and SMS activity logs)
VITE_DEMO_MODE=true

# Firebase Backend Configuration
VITE_FIREBASE_API_KEY=AIzaSyDsypqSLY7FfJTFc-dcuN9k7IKX36YvXWE
VITE_FIREBASE_AUTH_DOMAIN=shramik-quote.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shramik-quote
VITE_FIREBASE_STORAGE_BUCKET=shramik-quote.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=216325345229
VITE_FIREBASE_APP_ID=1:216325345229:web:ec0ba45114afe5823dfe84

# Backend Server & SQLite Database Configuration
PORT=3001
DATABASE_PATH=./data/shramik.db
JWT_SECRET=your_jwt_secret_key_change_in_production
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001

