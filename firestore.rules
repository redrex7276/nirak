rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matching request.auth.uid)
    // Fields:
    //   - id: string (required, immutable) - Unique User ID or SQ-C/SQ-F identifier
    //   - role: string (required, immutable) - 'customer' or 'freelancer'
    //   - name: string (required, length: 2-100) - Full Name
    //   - mobile: string (required, length: 10-20) - Contact phone number
    //   - email: string (optional, length: 5-100) - Email address
    //   - location: string (required, length: 2-100) - City or region
    //   - createdAt: string or timestamp (required, immutable) - Registration date
    //   - customerProfile: map (optional, allowed keys: customerType, businessName, cityArea)
    //   - freelancerProfile: map (optional, contains skills, experience, language, availability, etc.)
    //
    // Collection: jobs
    // Document ID: {jobId}
    // Fields:
    //   - id: string (required, immutable)
    //   - customerId: string (required, immutable) - ID of customer posting job
    //   - title: string (required, length: 3-200)
    //   - skillCategory: string (required, length: 2-100)
    //   - location: string (required, length: 2-100)
    //   - duration: string (required, length: 1-100)
    //   - budget: number (required, > 0)
    //   - description: string (required, length: 5-2000)
    //   - status: string (required, in ['open', 'in_progress', 'completed', 'cancelled'])
    //   - createdAt: string or timestamp (required, immutable)
    //
    // Collection: applications
    // Document ID: {applicationId}
    // Fields:
    //   - id: string (required, immutable)
    //   - jobId: string (required, immutable)
    //   - freelancerId: string (required, immutable)
    //   - status: string (required, in ['sent', 'shortlisted', 'accepted', 'rejected'])
    //   - appliedAt: string or timestamp (required, immutable)
    //
    // Collection: sms_logs
    // Document ID: {logId}
    // Fields:
    //   - id: string (required, immutable)
    //   - recipientMobile: string (required, length: 10-20)
    //   - message: string (required, length: 1-1000)
    //   - status: string (required, length: 1-50)
    //   - timestamp: string or timestamp (required)
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() >= 2 &&
             data.mobile is string &&
             data.role in ['customer', 'freelancer'];
    }

    function isValidJob(data) {
      return data.title is string && data.title.size() >= 3 &&
             data.category is string &&
             data.location is string &&
             data.status in ['open', 'in_progress', 'completed', 'cancelled'];
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: Customer profiles & Freelancer profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Jobs collection: Gig listings and opportunities
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // SMS logs collection: Internal audit log
    match /sms_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Work history collection
    match /work_history/{historyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Quotes collection: motivational quotes with vector embeddings
    match /quotes/{quoteId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }
  }
}
